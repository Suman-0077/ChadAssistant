# Copy this file to .env and fill in the real values.
# .env must NEVER be committed to git.

ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC-...
ALLOWED_TELEGRAM_ID=123456789
VAULT_PATH=/root/vault

# Optional: override the Claude model (defaults to claude-sonnet-4-5)
# MODEL=claude-sonnet-4-5

# IANA timezone name for the user (defaults to UTC — set to your real TZ)
# USER_TIMEZONE=Australia/Sydney

# M4 extractor mode:
#   shadow (default) — extractor runs, its proposed edits log to
#     memory-audit.log with source=extractor-shadow but do NOT touch memory.md
#   live             — edits also apply to memory.md (source=extractor)
# EXTRACTOR_MODE=shadow

# Optional: override the extractor model (defaults to claude-haiku-4-5)
# EXTRACTOR_MODEL=claude-haiku-4-5
