[Unit]
Description=Chad morning reminders — scan reminders.md and push items due today via Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/chad
ExecStart=/root/chad/.venv/bin/python -m chad.cron.morning_reminders
User=root

# Sandboxing — the script needs the vault, the venv, and outbound
# network. Nothing else. Least privilege per project plan §8.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/vault
